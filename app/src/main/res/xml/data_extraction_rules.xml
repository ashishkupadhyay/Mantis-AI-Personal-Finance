<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+: nothing is eligible for cloud backup or device-to-device transfer (NFR-20d). allowBackup="false" in
    the manifest already disables both; this file makes the intent explicit and survives a future manifest edit.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
